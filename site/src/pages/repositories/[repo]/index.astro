---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  RECORD_KINDS,
  buildRepositories,
  groupByStatus,
  isTerminalStatus,
  statusBadgeClass,
  statusLabel,
} from '../../../lib/repository-records';
import { groupBySections, groupingFor, parseGrouping } from '../../../lib/records';
import type { RecordKind } from '../../../lib/records';
import {
  FORK_OWNER,
  REPOSITORY_TABS,
  githubListTitle,
  githubListUrl,
  upstreamOwner,
} from '../../../lib/repository-tabs';
import type { GithubTab } from '../../../lib/repository-tabs';
import { originalRelPath } from '../../../lib/project-paths';

export async function getStaticPaths() {
  const repos = buildRepositories(await getCollection('repositoryFiles'));
  return repos.map(repo => ({ params: { repo: repo.slug.split('/')[1] }, props: { repo } }));
}

const { repo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const owner = upstreamOwner(repo.name, repo.records.map(r => r.index?.body ?? ''));
const isRecordKind = (id: string): id is RecordKind => (RECORD_KINDS as readonly string[]).includes(id);

const queueFor = (kind: RecordKind) => {
  const path = groupingFor(repo.name, kind);
  return path ? repo.otherFiles.find(f => `${originalRelPath(f)}.md` === path) : undefined;
};

const panels = REPOSITORY_TABS.flatMap(tab => {
  if (!isRecordKind(tab.id)) return [];
  const kind = tab.id;
  const queue = queueFor(kind);
  const grouping = queue ? parseGrouping(queue.body ?? '', `${originalRelPath(queue)}.md`, repo.name, kind) : undefined;
  const { sections, rest } = groupBySections(repo.records, kind, grouping);
  const groups = [
    ...sections.map(s => ({ label: s.label, badge: undefined, open: true, records: s.records })),
    ...groupByStatus(rest, kind).map(g => ({
      label: statusLabel(g.status),
      badge: statusBadgeClass(g.status),
      open: !isTerminalStatus(g.status),
      records: g.records,
    })),
  ].map(g => ({ ...g, hasTitles: g.records.some(r => r.title !== r.name) }));
  return [{ kind, label: tab.label, queue, groups, count: groups.reduce((n, g) => n + g.records.length, 0) }];
});

const tabClass = 'rounded border border-(--color-border) px-3 py-1 text-sm text-(--color-link) hover:underline data-active:bg-(--color-accent)/10 data-active:font-semibold';
---
<Base title={repo.name} pageTitle={repo.name}>
  <Breadcrumbs items={[
    { label: 'Home', href: `${base}/` },
    { label: 'Repositories', href: `${base}/repositories/` },
    { label: repo.name },
  ]} />

  <h1 class="mb-2 text-2xl font-bold">{repo.name}</h1>
  <nav class="mb-4 flex flex-wrap gap-2" aria-label="Repository tabs">
    {REPOSITORY_TABS.map(tab => {
      const panel = panels.find(p => p.kind === tab.id);
      return panel
        ? <a href={`#${panel.kind}`} data-tab={panel.kind} class={tabClass}>{panel.label} ({panel.count})</a>
        : <a href={githubListUrl(owner, repo.name, tab.id as GithubTab, FORK_OWNER)} title={githubListTitle(tab.id as GithubTab)}
            target="_blank" rel="noopener" class={tabClass}>{tab.label} ↗</a>;
    })}
  </nav>

  {panels.map(panel => (
    <section id={panel.kind} data-panel aria-labelledby={`${panel.kind}-heading`}>
      <h2 id={`${panel.kind}-heading`} class="mt-8 mb-3 text-xl font-bold border-b-2 border-(--color-accent)/20 pb-2">
        {panel.label}
      </h2>
      {panel.queue && (
        <p class="mb-3 text-sm text-(--color-text-secondary)">
          Grouped by <a href={`${base}/${panel.queue.id}/`} class="text-(--color-link) hover:underline">{originalRelPath(panel.queue).split('/').pop()}.md</a>
        </p>
      )}
      {panel.groups.length === 0 && <p class="text-sm text-(--color-text-muted)">No records.</p>}
      {panel.groups.map(group => (
        <details open={group.open} class="mb-3">
          <summary class="cursor-pointer select-none py-1 font-semibold">
            {group.badge ? <span class={group.badge}>{group.label}</span> : <span>{group.label}</span>}
            <span class="ml-2 text-sm font-normal text-(--color-text-muted)">({group.records.length})</span>
          </summary>
          <table class="data-table">
            <thead><tr><th>Record</th>{group.hasTitles && <th>Title</th>}</tr></thead>
            <tbody>
              {group.records.map(record => (
                <tr>
                  <td><a href={`${base}/${record.slug}/`}>{record.name}</a></td>
                  {group.hasTitles && <td class="text-sm text-(--color-text-muted)">{record.title === record.name ? '' : record.title}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      ))}
    </section>
  ))}

  {repo.otherFiles.length > 0 && (
    <section aria-labelledby="other-files">
      <h2 id="other-files" class="mt-8 mb-3 text-xl font-bold border-b-2 border-(--color-accent)/20 pb-2">Other files</h2>
      <ul>
        {repo.otherFiles.map(f => (
          <li><a href={`${base}/${f.id}/`} class="text-(--color-link) hover:underline">{originalRelPath(f).split('/').slice(2).join('/')}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  // Without JS every panel stays visible; the URL hash picks one, so #branches etc. links keep working.
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab]')];
  const show = () => {
    const hash = location.hash.slice(1);
    const current = panels.some(p => p.id === hash) ? hash : panels[0]?.id;
    for (const panel of panels) panel.hidden = panel.id !== current;
    for (const tab of tabs) tab.toggleAttribute('data-active', tab.dataset.tab === current);
  };
  addEventListener('hashchange', show);
  show();
</script>
