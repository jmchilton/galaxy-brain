  "module_path": "modules/nf-core/minimap2/align/main.nf",
  "meta": {
    "description": "A versatile pairwise aligner for genomic and spliced nucleotide sequences",
    "keywords": [
      "align",
      "fasta",
      "fastq",
      "genome",
      "paf",
      "reference"
    ],
    "authors": [
      "@heuermh",
      "@sofstam",
