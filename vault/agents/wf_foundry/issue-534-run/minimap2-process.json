  "container": "${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ? 'https://depot.galaxyproject.org/singularity/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:365b17b986c1a60c1b82c6066a9345f38317b763-0' : 'biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:365b17b986c1a60c1b82c6066a9345f38317b763-0' }",
  "conda": "${moduleDir}/environment.yml",
  "inputs": [
    {
      "name": "reads",
      "shape": "tuple val(meta), path(reads)",
      "topic": null
    },
    {
      "name": "reference",
      "shape": "tuple val(meta2), path(reference)",
      "topic": null
    },
    {
      "name": "bam_format",
      "shape": "val bam_format",
      "topic": null
    },
    {
      "name": "cigar_paf_format",
      "shape": "val cigar_paf_format",
      "topic": null
    },
    {
      "name": "cigar_bam",
      "shape": "val cigar_bam",
      "topic": null
    }
  ],
  "outputs": [
    {
      "name": "paf",
      "shape": "tuple val(meta), path(\"*.paf\"), optional: true, emit: paf",
      "topic": null
    },
    {
      "name": "bam",
      "shape": "tuple val(meta), path(\"*.bam\"), optional: true, emit: bam",
      "topic": null
    },
    {
      "name": "versions",
      "shape": "path \"versions.yml\" , emit: versions",
      "topic": null
    }
  ],
  "when": "task.ext.when == null || task.ext.when",
  "script_excerpt": "def args  = task.ext.args ?: ''\ndef args2 = task.ext.args2 ?: ''\ndef prefix = task.ext.prefix ?: \"${meta.id}\"\ndef bam_output = bam_format ? \"-a | samtools sort -@ ${task.cpus} -o ${prefix}.bam ${args2}\" : \"-o ${prefix}.paf\"\ndef cigar_paf = cigar_paf_format && !bam_format ? \"-c\" : ''\ndef set_cigar_bam = cigar_bam && bam_format ? \"-L\" : ''\n\"\"\"\nminimap2 \\\\\n    $args \\\\\n    -t $task.cpus \\\\\n    ${reference ?: reads} \\\\\n    $reads \\\\\n    $cigar_paf \\\\\n    $set_cigar_bam \\\\\n    $bam_output\n\n\ncat <<-END_VERSIONS > versions.yml\n\"${task.process}\":\n    minimap2: \\$(minimap2 --version 2>&1)\nEND_VERSIONS\n\"\"\"",
  "publish_dir": null
}
